# Prebetter Backend - All variables required (12-factor)
# Copy to .env and fill in all values

# Database
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_PRELUDE_DB=prelude
MYSQL_PREBETTER_DB=prebetter

# Auth: Better Auth (Nuxt) issues JWTs; the API verifies them via JWKS.
# Must equal the frontend BETTER_AUTH_URL (JWT issuer/audience + JWKS source).
BETTER_AUTH_URL=http://localhost:3000

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
