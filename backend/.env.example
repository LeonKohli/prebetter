# Prebetter Backend - required variables (12-factor)
# Copy to .env and fill in the values

# OpenSearch: index pattern with the daily event indices.
# Leave user and password empty for a node without the security plugin.
OPENSEARCH_URL=https://opensearch.example.org:9200
OPENSEARCH_INDEX=ids-events-*
# Index pattern with the daily request-line indices (one companion document per HTTP alert).
OPENSEARCH_REQUEST_INDEX=ids-requests-*
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# Auth: Better Auth (Nuxt) issues JWTs; the API verifies them via JWKS.
# Must equal the frontend BETTER_AUTH_URL (JWT issuer/audience + JWKS source).
BETTER_AUTH_URL=http://localhost:3000

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
