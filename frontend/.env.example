# Prebetter Frontend - Nuxt auto-maps NUXT_* to runtimeConfig (12-factor)
# Copy to .env and fill in all values

# API backend URL
NUXT_API_BASE=http://localhost:8000

# Better Auth (Nitro server-side)
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# DB connection for Better Auth (prebetter schema)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PREBETTER_DB=prebetter
